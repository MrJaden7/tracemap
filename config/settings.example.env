# Copy to .env in the repo root and adjust. Never commit .env.

# Database (matches docker-compose.yml defaults)
TRACEMAP_DB_HOST=localhost
TRACEMAP_DB_PORT=5440
TRACEMAP_DB_NAME=tracemap
TRACEMAP_DB_USER=tracemap
TRACEMAP_DB_PASSWORD=tracemap

# Local data folders (gitignored)
TRACEMAP_VOCAB_DIR=data/vocab
TRACEMAP_SYNTHEA_DIR=data/synthea

# Secret salt for HMAC-SHA256 pseudonymised linkage (Phase 2). Use a long random value.
TRACEMAP_LINKAGE_SALT=change-me

# Anthropic API (used only by `tracemap ai evaluate --use-llm`).
# Only synthetic terms from the gold set are ever sent to the API.
ANTHROPIC_API_KEY=
